# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
DATABASE_PATH=./database/praktika.db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# OpenAI Configuration (for AI responses)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# ElevenLabs Configuration (for Text-to-Speech)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Speech Recognition (Optional - can use browser's built-in)
SPEECH_API_KEY=your_speech_api_key_here

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Bulgarian Language Specific
BULGARIAN_VOICE_ID=your_bulgarian_voice_id_here
CYRILLIC_FONT_PATH=./assets/fonts/cyrillic.ttf

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Avatar Images
AVATAR_IMAGE_PATH=./public/avatars
DEFAULT_AVATAR_IMAGE=/avatars/default.png

# Bulgarian Cultural Content
BULGARIAN_CULTURAL_API=https://api.bulgarian-culture.com
BULGARIAN_NEWS_API=https://api.bta.bg